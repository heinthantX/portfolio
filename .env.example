# Resend API key used to deliver contact form messages
RESEND_API_KEY=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=
# Verified sender address, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Public origin used for canonical URLs, sitemap and RSS
NEXT_PUBLIC_SITE_URL=
# Hero chapter pace in seconds: one full chapter, and the shortest finish (defaults 1 and 0.4; read at build time)
NEXT_PUBLIC_CHAPTER_STEP_S=
NEXT_PUBLIC_CHAPTER_MIN_S=
